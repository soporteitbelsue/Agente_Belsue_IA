OPENAI_API_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Versiones públicas (navegador): subida directa de documentos a Supabase Storage
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
ADMIN_KEY=
NEXTAUTH_SECRET=       # string aleatorio largo (genera con: openssl rand -base64 32)
NEXTAUTH_URL=          # http://localhost:3000 en local, https://tudominio.es en producción
# Avisos por correo (Resend). Sin RESEND_API_KEY, los avisos se omiten.
RESEND_API_KEY=
NOTIFY_EMAIL=soporteit@belsue.es
EMAIL_FROM=Asistente Belsué <onboarding@resend.dev>
# Buzón de correo que el agente puede leer (IMAP, solo lectura). Sin
# IMAP_USER/IMAP_PASSWORD la herramienta de correo no aparece. Solo la ve el
# usuario del agente cuyo email coincide con MAILBOX_OWNER_EMAIL (por defecto IMAP_USER).
IMAP_HOST=imap.ionos.es
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
MAILBOX_OWNER_EMAIL=
